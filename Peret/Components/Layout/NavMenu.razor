@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-lg navbar-dark peret-navbar">
    <div class="container d-flex align-items-center">
        <a class="navbar-brand" href="">Peret</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#peretNav"
                aria-controls="peretNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="peretNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center gap-1">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="read">Read</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="trivia">Trivia</NavLink>
                </li>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="dashboard">My Progress</NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>

            <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Manage">
                                @context.User.Identity?.Name
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post" class="d-flex align-items-center m-0">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="btn btn-sm btn-peret-primary">Logout</button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Register">Register</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="btn btn-sm btn-peret-primary" href="Account/Login">Login</NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}